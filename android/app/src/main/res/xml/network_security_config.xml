<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Accelerated downloads (an experimental setting) read from a proxy inside the app
         (lib/app/utils/parallel_range_proxy.dart) over plain HTTP on the loopback address. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
